# ─── Stage 1: Builder ────────────────────────────────────────────────
FROM rust:1.79-alpine AS builder

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconf

WORKDIR /app

COPY apps/agent/ ./apps/agent/
COPY Cargo.toml Cargo.lock ./

# Build only the agent with static linking
ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN cargo build --release --bin raksha-agent

# ─── Stage 2: Runtime (distroless-like minimal image) ────────────────
FROM alpine:3.20 AS runtime

RUN apk add --no-cache ca-certificates tini && \
    addgroup -S raksha && adduser -S raksha -G raksha

COPY --from=builder /app/target/release/raksha-agent /usr/local/bin/raksha-agent

RUN mkdir -p /etc/raksha && chown raksha:raksha /etc/raksha

USER raksha

ENTRYPOINT ["tini", "--"]
CMD ["raksha-agent"]
