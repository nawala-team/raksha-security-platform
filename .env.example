# Raksha Security Platform - Environment Configuration
# Copy to .env and fill in actual values

# Server
RAKSHA__SERVER__HOST=0.0.0.0
RAKSHA__SERVER__PORT=8080

# Database (PostgreSQL)
RAKSHA__DATABASE__URL=postgres://raksha:raksha_dev@localhost:5432/raksha_platform
RAKSHA__DATABASE__MAX_CONNECTIONS=10
RAKSHA__DATABASE__MIN_CONNECTIONS=2

# Redis
RAKSHA__REDIS__URL=redis://localhost:6379
RAKSHA__REDIS__POOL_SIZE=10

# JWT
RAKSHA__JWT__SECRET=change-this-to-a-secure-random-string-in-production
RAKSHA__JWT__ACCESS_TOKEN_TTL_SECS=900
RAKSHA__JWT__REFRESH_TOKEN_TTL_SECS=604800
RAKSHA__JWT__ISSUER=raksha-platform

# Application
RAKSHA__APP__NAME=Raksha Security Platform
RAKSHA__APP__ENVIRONMENT=development
RAKSHA__APP__LOG_LEVEL=info
