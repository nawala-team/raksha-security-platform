# Raksha Security Platform - Environment Configuration
# Copy to .env and fill in actual values

# Server
RAKSHA__SERVER__HOST=0.0.0.0
RAKSHA__SERVER__PORT=8080

# Database (PostgreSQL)
RAKSHA__DATABASE__URL=postgres://raksha:raksha_dev@localhost:5432/raksha_platform
RAKSHA__DATABASE__MAX_CONNECTIONS=10
RAKSHA__DATABASE__MIN_CONNECTIONS=2

# Redis
RAKSHA__REDIS__URL=redis://localhost:6379
RAKSHA__REDIS__POOL_SIZE=10

# JWT
RAKSHA__JWT__SECRET=change-this-to-a-secure-random-string-in-production
RAKSHA__JWT__ACCESS_TOKEN_TTL_SECS=900
RAKSHA__JWT__REFRESH_TOKEN_TTL_SECS=604800
RAKSHA__JWT__ISSUER=raksha-platform

# Application
RAKSHA__APP__NAME=Raksha Security Platform
RAKSHA__APP__ENVIRONMENT=development
RAKSHA__APP__LOG_LEVEL=info

# ─── Docker Compose Service Ports ────────────────────────────────────────────
PORTAL_PORT=8080
WEB_PORT=3000
ML_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
TIMESCALE_PORT=5433
OPENSEARCH_PORT=9200

# ─── Credentials ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=raksha_secret
REDIS_PASSWORD=
JWT_SECRET=change_me_in_production
RAKSHA_VERSION=latest

# ─── SIEM Integration (Sprint 2) ────────────────────────────────────────────
# Enable SIEM log forwarding (starts the Fluentd container)
# Usage: docker compose --profile siem up
SIEM_ENABLED=false

# Target SIEM system: splunk | elasticsearch | wazuh | graylog | syslog | loki
SIEM_TARGET=splunk

# SIEM connection settings
SIEM_HOST=
SIEM_PORT=
# Authentication token (HEC token for Splunk, password for Elastic, API key for others)
SIEM_TOKEN=
# Username for targets that require basic auth (e.g., Elasticsearch)
SIEM_USER=

# Log format: cef (Common Event Format) | leef | json | syslog (RFC 5424)
SIEM_FORMAT=cef

# TLS settings for SIEM connection
SIEM_TLS_ENABLED=true
SIEM_TLS_VERIFY=true

# Performance tuning
# How often to flush buffered logs to SIEM (e.g., 5s, 30s, 1m)
SIEM_FLUSH_INTERVAL=5s
# Buffer size in MB before forcing a flush
SIEM_BUFFER_SIZE=256

# ─── Splunk-specific settings ────────────────────────────────────────────────
# Only needed when SIEM_TARGET=splunk
SPLUNK_INDEX=raksha_security

# ─── Syslog-specific settings ───────────────────────────────────────────────
# Only needed when SIEM_TARGET=syslog
# Protocol: tcp | udp | tls
SYSLOG_PROTOCOL=tcp

# ─── Graylog-specific settings ──────────────────────────────────────────────
# Only needed when SIEM_TARGET=graylog
# Protocol: udp | tcp
GELF_PROTOCOL=udp

# ─── Dashboard → Portal proxy ───────────────────────────────────────────────
# The Next.js dashboard proxies /api/* to the portal (see apps/web/next.config.js).
#
# IMPORTANT: `rewrites()` is evaluated during `next build`, so this value is
# baked into .next/routes-manifest.json. Setting it only at runtime has no
# effect on an already-built image — export it before building.
#
#   docker compose (portal is the service name):  http://portal:8080
#   local/bare-metal:                             http://localhost:8080
PORTAL_API_URL=http://localhost:8080

# ─── Monitoring Stack (optional) ────────────────────────────────────────────
# Usage: docker compose --profile monitoring up
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
PROMETHEUS_PORT=9090
