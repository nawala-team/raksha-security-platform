{
  "name": "raksha-security-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Comprehensive infrastructure security monitoring and compliance platform",
  "keywords": [
    "security",
    "monitoring",
    "compliance",
    "infrastructure",
    "threat-detection",
    "nawala"
  ],
  "homepage": "https://github.com/dansiapa/raksha-security-platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/dansiapa/raksha-security-platform.git"
  },
  "license": "MIT",
  "author": "NAWALA TEAM",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:dashboard",
    "build:dashboard": "npm -w @raksha/web run build",
    "dev": "npm -w @raksha/web run dev",
    "lint": "npm -w @raksha/web run lint",
    "test": "npm -w @raksha/web run test",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "husky": "9.1.6",
    "lint-staged": "^17.2.0",
    "prettier": "3.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
